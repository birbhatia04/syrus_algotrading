# Fill credentials locally; exchange once with python -m app.brokers.login_021.
ENVIRONMENT=021_SANDBOX
BROKER_021_USERNAME=
BROKER_021_PASSWORD=
BROKER_021_ACCESS_TOKEN=
# Bind the sandbox exclusively to this local account ID (/api/v1/me).
BROKER_021_ACCOUNT_ID=1
BROKER_021_DEFAULT_SYMBOL=RELIANCE
# Published 021 NSE cash INTRADAY charge schedule (021.trade/pricing).
# Values below are the 021 Intraday rates; override to match the kickoff table.
CHARGE_SEGMENT=EQUITY_INTRADAY
BROKERAGE_RATE=0.0003
BROKERAGE_CAP=20
STT_RATE=0.00025
EXCHANGE_TXN_RATE=0.0000297
SEBI_RATE=0.000001
IPFT_RATE=0.000001
STAMP_DUTY_RATE=0.00003
GST_RATE=0.18
GST_INCLUDES_STAMP_DUTY=true
# Tradeable session (IST). Unset => docker compose uses the 021 sandbox's
# open-ended window (00:00-23:59) so strategies run whenever the feed is live.
# MARKET_OPEN_IST=00:00
# MARKET_CLOSE_IST=23:59
# TIME_ENTRY_WINDOW_SECONDS=86340
DATABASE_URL=sqlite:///./algorhythm_021.db
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
