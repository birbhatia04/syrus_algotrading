# Local non-Docker default is sqlite:///./aegis.db
DATABASE_URL=postgresql+psycopg://aegis:aegis_local_only@localhost:5432/aegis
ENVIRONMENT=SIMULATOR
CORS_ORIGINS=http://localhost:5173
# Set ENVIRONMENT=ALPACA_PAPER only after adding paper credentials below.
ALPACA_API_KEY_ID=
ALPACA_API_SECRET_KEY=
ALPACA_DATA_FEED=iex
ALPACA_DEFAULT_SYMBOL=AAPL
