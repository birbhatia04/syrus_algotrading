# Local non-Docker default is sqlite:///./aegis.db
DATABASE_URL=postgresql+psycopg://aegis:aegis_local_only@localhost:5432/aegis
ENVIRONMENT=SIMULATOR
CORS_ORIGINS=http://localhost:5173
# Set ENVIRONMENT=UPSTOX_SANDBOX after adding both Upstox tokens below.
# Analytics Token: live Indian market data. Sandbox token: test-only orders.
UPSTOX_ANALYTICS_TOKEN=
UPSTOX_SANDBOX_ACCESS_TOKEN=
UPSTOX_DEFAULT_SYMBOL=INFY
UPSTOX_DEFAULT_INSTRUMENT_KEY=NSE_EQ|INE009A01021
